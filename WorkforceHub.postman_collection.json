            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Amit\",\n  \"lastName\": \"Shah\",\n  \"jobTitle\": \"Lead Backend Architect\",\n  \"salary\": 1800000.00,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employees/1",
