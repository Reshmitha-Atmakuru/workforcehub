            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/employees?department=Engineering&status=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"],
              "query": [
                { "key": "department", "value": "Engineering" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
