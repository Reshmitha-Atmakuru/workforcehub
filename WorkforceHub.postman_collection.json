              "raw": "{\n  \"firstName\": \"Amit\",\n  \"lastName\": \"Shah\",\n  \"email\": \"amit.shah@workforcehub.com\",\n  \"phone\": \"+91 99887 76655\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Senior Backend Architect\",\n  \"accountRole\": \"ROLE_EMPLOYEE\",\n  \"salary\": 1500000.00,\n  \"joinDate\": \"2026-03-01\",\n  \"status\": \"ACTIVE\",\n  \"officeLocation\": \"Hyderabad, TS\",\n  \"skills\": [\"Java\", \"Spring Boot\", \"MySQL\", \"Kafka\"]\n}"
