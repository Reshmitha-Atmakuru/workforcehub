# ============================================================
# WorkforceHub - Environment Variables Template
# Copy this file to .env (never commit .env to Git)
# ============================================================

# ─── MySQL Database ─────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/workforce_hub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# ─── JWT Secret ─────────────────────────────────────────────
# Minimum 256-bit (32-character) random string
JWT_SECRET=replace_with_a_strong_random_256bit_secret_key_here

# ─── Gmail SMTP (optional, for notifications) ───────────────
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
